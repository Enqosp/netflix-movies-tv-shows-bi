	column 'Clasificacion Edad' =
			
			SWITCH(
			    TRUE(),
			    netflix_titles[rating] IN {"TV-MA", "R", "NC-17", "UR", "NR"}, "Adultos (17+)",
			    netflix_titles[rating] IN {"TV-14", "PG-13"}, "Adolescentes (13+)",
			    netflix_titles[rating] IN {"PG", "TV-PG", "TV-Y7", "TV-Y7-FV"}, "Niños (7+)",
			    netflix_titles[rating] IN {"G", "TV-Y", "TV-G"}, "Todo Público",
			    "Sin Clasificar"
			)
		lineageTag: d4d87adf-44e8-4d54-a02f-66426d55da74
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

